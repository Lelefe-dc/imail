<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="IMail.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontFamily" Value="Inter"/><Setter Property="Background" Value="#F6F8F7"/></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#064A34"/><Setter Property="Foreground" Value="White"/><Setter Property="CornerRadius" Value="10"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="10"/></Style>
  </Application.Styles>
</Application>
